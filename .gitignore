# Dependencies — restored via `npm install`, never committed.
node_modules/

# Vite build output (each app's own dist/, wherever it lives in the tree).
dist/
dist-ssr/

# Vite's own local cache.
.vite/

# Editor/OS noise.
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# npm/yarn logs from a failed install.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files, if any app ever adds one (API keys, etc — never commit these).
.env
.env.local
.env.*.local
